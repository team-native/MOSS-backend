# Database
DB_URL=jdbc:mysql://localhost:3306/moss?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=change-me

# JWT signing secret (use a random value of at least 32 bytes)
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# SMTP email delivery
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=your-address@gmail.com
